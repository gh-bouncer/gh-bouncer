#!/usr/bin/env bash
# gh bouncer: run the bouncer review for your pull request, in your fork, on your own API key.
# https://github.com/gh-bouncer/gh-bouncer
set -euo pipefail

VERSION="0.3.0"
WORKFLOW="bouncer.yml"
WORKFLOW_PATH=".github/workflows/$WORKFLOW"
ACTION_REPO="gh-bouncer/action"
ACTION_REF="${GH_BOUNCER_ACTION_REF:-v1}"
SETUP_BRANCH="bouncer-setup"
SITE="https://gh-bouncer.com"
KEYS_URL="https://console.anthropic.com/settings/keys"
POLL_SECONDS="${GH_BOUNCER_POLL_SECONDS:-3}"        # waiting for a run or a workflow to show up
VERDICT_SECONDS="${GH_BOUNCER_VERDICT_SECONDS:-10}" # polling the bouncer's state for the result
VERDICT_TRIES="${GH_BOUNCER_VERDICT_TRIES:-18}"     # about 3 minutes

# The key is read once and kept out of the environment of every command this script runs.
ENV_KEY="${ANTHROPIC_API_KEY:-}"
unset ANTHROPIC_API_KEY

# --- output, the gh way ------------------------------------------------------------------
# Messages go to stderr: ✓ green when done, X red when not, ! yellow for warnings, gray for
# details. Colors only on a terminal, with NO_COLOR, CLICOLOR, CLICOLOR_FORCE and GH_FORCE_TTY
# working as they do in gh.
color=0
case "${GH_FORCE_TTY:-}" in ''|0|false|no) tty=0 ;; *) tty=1 ;; esac
[ ! -t 2 ] || tty=1
if [ -n "${CLICOLOR_FORCE:-}" ] && [ "$CLICOLOR_FORCE" != 0 ]; then
  color=1
elif [ -z "${NO_COLOR:-}" ] && [ "${CLICOLOR:-}" != 0 ] && [ "$tty" = 1 ]; then
  color=1
fi
if [ "$color" = 1 ]; then
  C_OK=$'\e[32m' C_ERR=$'\e[31m' C_WARN=$'\e[33m' C_GRAY=$'\e[90m' C_BOLD=$'\e[1m' C_OFF=$'\e[0m'
else
  C_OK='' C_ERR='' C_WARN='' C_GRAY='' C_BOLD='' C_OFF=''
fi
say()  { printf '%s\n' "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_OFF" "$*" >&2; }
warn() { printf '%s!%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
bad()  { printf '%sX%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; }
gray() { printf '  %s%s%s\n' "$C_GRAY" "$*" "$C_OFF" >&2; }
hint() { local line; for line in "$@"; do [ -z "$line" ] || printf '  %s\n' "$line" >&2; done; }
# die <what went wrong> [<what to do>...]
die() { bad "$1"; shift; hint "$@"; exit 1; }
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# --- talking to GitHub -------------------------------------------------------------------------
# ghc runs gh and keeps its error message for explanations, in a file so it survives $(...).
ERRF="$(mktemp)"
TEMP=("$ERRF")
trap 'rm -rf "${TEMP[@]}"' EXIT
ghc() { gh "$@" 2>"$ERRF"; }
api() { ghc api "$@"; }
gh_msg() { sed -e 's/^gh: //' "$ERRF" | grep -v '^[[:space:]]*$' | head -n 1; }
is_404() { grep -q 'HTTP 404' "$ERRF"; }
# reachable <gh exit code>: stop when gh isn't logged in (exit 4) or GitHub can't be reached
reachable() {
  if [ "$1" = 4 ] || grep -q 'gh auth login' "$ERRF"; then
    bad "You're not logged in to GitHub CLI."
    hint "Run gh auth login, then try again."
    exit 4
  fi
  if grep -q 'HTTP 401' "$ERRF"; then
    bad "Your GitHub CLI login has expired or was revoked."
    hint "Run gh auth login, then try again."
    exit 4
  fi
  if grep -qiE 'error connecting to|dial tcp|no such host|connection refused|network is unreachable|i/o timeout|TLS handshake' "$ERRF"; then
    die "Couldn't connect to GitHub." "Check your internet connection, then try again."
  fi
}
# gh_failed <gh exit code> [<message when not found> [<what to do>...]]
gh_failed() {
  local rc="$1"
  shift
  reachable "$rc"
  if [ $# -gt 0 ] && is_404; then die "$@"; fi
  die "GitHub returned an error: $(gh_msg)" "Try again in a minute. If it keeps happening, check https://www.githubstatus.com"
}

usage() {
  cat <<EOF
Run the bouncer review for your pull request, in your fork, on your own Anthropic API
key. The project's bouncer then checks the signed review and posts the result.

USAGE
  gh bouncer [<pr-url> | <owner/repo#number> | <number>] [flags]
  gh bouncer init [-R OWNER/REPO]

With no argument, it uses the pull request for the current branch.
gh bouncer init is for maintainers: it opens a pull request that installs bouncer.

FLAGS
  -R, --repo OWNER/REPO   Upstream repository, when giving just a number
      --set-key           Replace the ANTHROPIC_API_KEY secret in your fork
      --no-watch          Start the review and exit without waiting for the result
  -h, --help              Show help
  -v, --version           Show the version

ENVIRONMENT
  ANTHROPIC_API_KEY       Your Anthropic API key, used instead of asking when your fork
                          needs one. It's stored only as an Actions secret in your fork.
  NO_COLOR, CLICOLOR, CLICOLOR_FORCE, GH_FORCE_TTY
                          Colors and terminal output, as in gh

EXIT CODES
  0  Passed, nothing to do, or the result isn't in yet
  1  Bounced, or something went wrong
  2  Stopped with Ctrl-C (the review keeps running)
  4  Not logged in to GitHub CLI

EXAMPLES
  \$ gh bouncer https://github.com/acme/widget/pull/412
  \$ gh bouncer acme/widget#412
  \$ gh bouncer --set-key https://github.com/acme/widget/pull/412

LEARN MORE
  $SITE
  https://github.com/gh-bouncer/gh-bouncer
EOF
}

# --- gh bouncer init: install bouncer in a repository (maintainers) ----------------
init_usage() {
  cat <<EOF
Open a pull request that installs bouncer in your repository, or updates its workflow.

USAGE
  gh bouncer init [-R OWNER/REPO]

FLAGS
  -R, --repo OWNER/REPO   Repository to install bouncer in (default: the current one)
  -h, --help              Show help

It adds:
  .github/workflows/bouncer.yml   the gate, plus the review job forks inherit
  .bouncer.yml                    the Repo Config: review agent, gate, pre-checks,
                                  guidance and Agent Rules (kept if you have one)

LEARN MORE
  Build a .bouncer.yml in the browser: $SITE/#config
EOF
}

INIT_REPO=""
ADDED=""

drop_setup_branch() { gh api -X DELETE "repos/$INIT_REPO/git/refs/heads/$SETUP_BRANCH" >/dev/null 2>&1 || true; }
# put_file <path in repo> <local file> <commit message> <keep existing: yes|no> <description>
put_file() {
  local path="$1" src="$2" message="$3" keep="$4" what="$5" existing rc=0
  existing="$(api -X GET "repos/$INIT_REPO/contents/$path" -f ref="$SETUP_BRANCH" --jq .sha)" || rc=$?
  if [ "$rc" != 0 ]; then
    is_404 || { drop_setup_branch; gh_failed "$rc"; }
    existing=""
  fi
  if [ -n "$existing" ] && [ "$keep" = "yes" ]; then
    ok "Kept your existing $path"
    ADDED="${ADDED}- \`$path\`: kept as it is"$'\n'
    return 0
  fi
  local args=(-X PUT "repos/$INIT_REPO/contents/$path" -f message="$message" -f branch="$SETUP_BRANCH"
    -f content="$(base64 <"$src" | tr -d '\n')")
  [ -z "$existing" ] || args+=(-f sha="$existing")
  rc=0
  api "${args[@]}" >/dev/null || rc=$?
  if [ "$rc" != 0 ]; then
    drop_setup_branch
    reachable "$rc"
    if grep -q 'workflow.*scope' "$ERRF"; then
      die "Adding a workflow file needs the workflow scope on your gh login." \
        "Run gh auth refresh -s workflow, then gh bouncer init again."
    fi
    die "Couldn't add $path to $INIT_REPO: $(gh_msg)" "Nothing was changed. Run gh bouncer init again."
  fi
  if [ -n "$existing" ]; then ok "Updated $path"; else ok "Added $path"; fi
  ADDED="${ADDED}- \`$path\`: $what"$'\n'
}

cmd_init() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) init_usage; exit 0 ;;
      -R|--repo) [ $# -ge 2 ] || die "$1 needs a value: -R OWNER/REPO"; INIT_REPO="$2"; shift 2 ;;
      --repo=*) INIT_REPO="${1#--repo=}"; shift ;;
      -*) die "Unknown flag: $1" "Run gh bouncer init --help for usage." ;;
      *) die "Unknown argument: $1" "Run gh bouncer init --help for usage." ;;
    esac
  done
  local rc=0
  if [ -z "$INIT_REPO" ]; then
    INIT_REPO="$(ghc repo view --json nameWithOwner --jq .nameWithOwner)" || {
      reachable $?
      die "Not in a clone of a GitHub repository." "Run this in your project's folder, or pass -R OWNER/REPO."
    }
  fi
  case "$INIT_REPO" in */?*) ;; *) die "'$INIT_REPO' isn't a repository. Use -R OWNER/REPO." ;; esac

  local info can_push is_fork default_branch parent
  info="$(api "repos/$INIT_REPO" --jq '[(.permissions.push // false), .fork, .default_branch, (.parent.full_name // "")]
    | map(tostring | if . == "" then "-" else . end) | join("\t")')" ||
    gh_failed $? "Repository $INIT_REPO doesn't exist, or you can't see it." "Check the name, or pass -R OWNER/REPO."
  IFS=$'\t' read -r can_push is_fork default_branch parent <<<"$info"
  [ "$is_fork" != "true" ] ||
    die "$INIT_REPO is a fork of $parent. Install bouncer in the original project instead:" "gh bouncer init -R $parent"
  [ "$can_push" = "true" ] ||
    die "You need write access to $INIT_REPO to install bouncer." "Ask one of its maintainers to run gh bouncer init."

  local tmp
  tmp="$(mktemp -d)"
  TEMP+=("$tmp")
  api "repos/$ACTION_REPO/contents/templates/bouncer.yml?ref=$ACTION_REF" -H "Accept: application/vnd.github.raw" >"$tmp/workflow" ||
    gh_failed $? "Couldn't find the bouncer workflow template in $ACTION_REPO@$ACTION_REF."
  api "repos/$ACTION_REPO/contents/templates/.bouncer.yml?ref=$ACTION_REF" -H "Accept: application/vnd.github.raw" >"$tmp/config" ||
    gh_failed $? "Couldn't find the .bouncer.yml template in $ACTION_REPO@$ACTION_REF."

  # Already installed? Then there's nothing to do, or only the workflow to update.
  local current update=""
  current="$(api "repos/$INIT_REPO/contents/$WORKFLOW_PATH?ref=$default_branch" -H "Accept: application/vnd.github.raw")" || rc=$?
  if [ "$rc" = 0 ]; then
    if [ "$current" = "$(cat "$tmp/workflow")" ]; then
      ok "Bouncer is already installed in $INIT_REPO, with the current workflow."
      gray "Its settings are in .bouncer.yml on $default_branch. Build one at $SITE/#config"
      exit 0
    fi
    update=1
  elif ! is_404; then
    gh_failed "$rc"
  fi

  # A setup branch left from an earlier run.
  rc=0
  api "repos/$INIT_REPO/git/ref/heads/$SETUP_BRANCH" --jq .ref >/dev/null || rc=$?
  if [ "$rc" = 0 ]; then
    local open_pr
    open_pr="$(ghc pr list -R "$INIT_REPO" --head "$SETUP_BRANCH" --json url --jq '.[0].url // empty' || true)"
    [ -z "$open_pr" ] ||
      die "There's already a bouncer setup pull request: $open_pr" "Merge or close it, then run gh bouncer init again if you still need to."
    die "The $SETUP_BRANCH branch already exists in $INIT_REPO, with no open pull request." \
      "Delete it with: gh api -X DELETE repos/$INIT_REPO/git/refs/heads/$SETUP_BRANCH" "Then run gh bouncer init again."
  elif ! is_404; then
    gh_failed "$rc"
  fi

  local base_sha
  base_sha="$(api "repos/$INIT_REPO/git/ref/heads/$default_branch" --jq .object.sha)" || gh_failed $?
  api -X POST "repos/$INIT_REPO/git/refs" -f ref="refs/heads/$SETUP_BRANCH" -f sha="$base_sha" >/dev/null || {
    rc=$?
    reachable "$rc"
    die "Couldn't create the $SETUP_BRANCH branch in $INIT_REPO: $(gh_msg)"
  }

  local title body
  if [ -n "$update" ]; then
    title="Update bouncer workflow"
    put_file "$WORKFLOW_PATH" "$tmp/workflow" "Update bouncer workflow" no "updated to the current template"
    put_file ".bouncer.yml" "$tmp/config" "Add bouncer Repo Config" yes "the Repo Config, with the default settings"
    body="This updates [bouncer]($SITE) in this repository to the current template from \`$ACTION_REPO@$ACTION_REF\`.

**Changes**
${ADDED}
If you changed the workflow by hand, check the diff and carry your changes over before merging. Settings stay in \`.bouncer.yml\`."
  else
    title="Add bouncer"
    put_file "$WORKFLOW_PATH" "$tmp/workflow" "Add bouncer workflow" no "the gate for this repository, plus the review job that forks inherit"
    put_file ".bouncer.yml" "$tmp/config" "Add bouncer Repo Config" yes "the Repo Config (review agent, gate, pre-checks, guidance and Agent Rules)"
    body="This installs [bouncer]($SITE). Pull requests from people outside the team are held as drafts until their author runs an AI review in their own fork, on their own Anthropic API key, and GitHub signs the result. Passing pull requests reach you with the review attached; bounced ones are closed with the reasons. Maintainers pay nothing.

**Adds**
${ADDED}
**Before merging**
- Edit \`guidance\` in \`.bouncer.yml\`: what this project is for and what you never accept. It matters more than any other setting.
- Check the Agent Rules. A broken Required rule (\`hard: true\`) fails a pull request; an Advisory rule (\`hard: false\`) is only reported to you. The [Repo Config builder]($SITE/#config) can generate the file.

**After merging**
- New outside pull requests get a comment telling the author to run \`gh bouncer <url>\`. Open ones are held the next time they're updated.
- The repository's owners, members and collaborators are exempt, and so are the bots under \`exempt_users\`. Past contributors are not, unless you set \`exempt_prior_contributors: true\`. Label a pull request \`bouncer:skip\` to exempt it by hand, or reopen a bounced one yourself to override the verdict.
- To try it on yourself, set \`exempt_maintainers: false\` under \`gate:\`, open a pull request from a fork and run \`gh bouncer <its url>\`."
  fi

  local pr_url
  pr_url="$(ghc pr create -R "$INIT_REPO" --base "$default_branch" --head "$SETUP_BRANCH" --title "$title" --body "$body")" || {
    rc=$?
    reachable "$rc"
    die "The files are on the $SETUP_BRANCH branch, but opening the pull request failed: $(gh_msg)" \
      "Open it from https://github.com/$INIT_REPO/compare/$default_branch...$SETUP_BRANCH"
  }
  ok "Opened $pr_url"
  say ""
  say "Next:"
  if [ -n "$update" ]; then
    say "  1. Check the changes and merge the pull request"
    return 0
  fi
  say "  1. Edit guidance and Agent Rules in .bouncer.yml on the $SETUP_BRANCH branch"
  gray "   or build the file at $SITE/#config"
  say "  2. Merge the pull request to turn bouncer on"
  say "  3. Try it: set exempt_maintainers: false, open a pull request from a fork,"
  say "     and run gh bouncer <its url>"
}

if [ "${1:-}" = "init" ]; then
  shift
  cmd_init "$@"
  exit 0
fi

ARG=""
UPSTREAM=""
SET_KEY=0
WATCH=1
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "gh bouncer version $VERSION"; exit 0 ;;
    -R|--repo) [ $# -ge 2 ] || die "$1 needs a value: -R OWNER/REPO"; UPSTREAM="$2"; shift 2 ;;
    --repo=*) UPSTREAM="${1#--repo=}"; shift ;;
    --set-key) SET_KEY=1; shift ;;
    --no-watch) WATCH=0; shift ;;
    -*) die "Unknown flag: $1" "Run gh bouncer --help for usage." ;;
    *) [ -z "$ARG" ] || die "Give one pull request at a time." "Run gh bouncer --help for usage."; ARG="$1"; shift ;;
  esac
done

# --- which pull request -------------------------------------------------------
parse_url() {
  # https://github.com/OWNER/REPO/pull/N[/...][?...][#...]
  local rest="${1#*://}"
  rest="${rest%%\?*}"
  rest="${rest%%#*}"
  local host owner repo kind num
  IFS=/ read -r host owner repo kind num _ <<<"$rest"
  [ "$host" = "github.com" ] || die "Only github.com pull requests are supported: $1"
  [ "$kind" = "pull" ] && [ -n "$num" ] ||
    die "Not a pull request URL: $1" "It should look like https://github.com/OWNER/REPO/pull/123"
  UPSTREAM="$owner/$repo"
  NUMBER="$num"
}

NUMBER=""
if [ -z "$ARG" ]; then
  url="$(ghc pr view --json url --jq .url)" || {
    reachable $?
    die "No pull request found for the current branch." "Pass its URL: gh bouncer https://github.com/OWNER/REPO/pull/123"
  }
  parse_url "$url"
else
  case "$ARG" in
    http://*|https://*) parse_url "$ARG" ;;
    */*\#*) UPSTREAM="${ARG%%\#*}"; NUMBER="${ARG#*\#}" ;;
    \#*) NUMBER="${ARG#\#}" ;;
    *) NUMBER="$ARG" ;;
  esac
fi
case "$NUMBER" in ''|*[!0-9]*) die "'$NUMBER' isn't a pull request number." "Pass the pull request's URL instead." ;; esac
if [ -z "$UPSTREAM" ]; then
  UPSTREAM="$(ghc repo view --json nameWithOwner,parent \
    --jq 'if .parent then "\(.parent.owner.login)/\(.parent.name)" else .nameWithOwner end')" || {
    reachable $?
    die "Can't tell which repository #$NUMBER is in." "Pass the pull request's URL, or add -R OWNER/REPO."
  }
fi
case "$UPSTREAM" in */?*) ;; *) die "'$UPSTREAM' isn't a repository. Use -R OWNER/REPO." ;; esac
REF="$UPSTREAM#$NUMBER"

# --- the pull request, and what the project's bouncer says about it ----------------
# Empty fields become "-" so tab-separated values don't collapse when read back.
PR_JQ='[.state, (.merged_at != null), (.head.repo.full_name // ""), .head.ref, .head.sha, .html_url,
  ([.labels[].name] | join(","))] | map(tostring | if . == "" then "-" else . end) | join("\t")'
load_pr() {
  local info
  info="$(api "repos/$UPSTREAM/pulls/$NUMBER" --jq "$PR_JQ")" || return $?
  IFS=$'\t' read -r PR_STATE PR_MERGED HEAD_REPO HEAD_REF HEAD_SHA PR_URL LABELS <<<"$info"
  [ "$HEAD_REPO" != "-" ] || HEAD_REPO=""
  [ "$LABELS" != "-" ] || LABELS=""
}
has_label() { case ",$LABELS," in *",$1,"*) return 0 ;; esac; return 1; }

# The bouncer keeps its state in a comment by github-actions[bot]:
#   <!-- bouncer:state {"sha": ..., "status": ..., "left": ..., ...} -->
# Comments by anyone else are ignored, so they can't fake it. Fields an older bouncer doesn't
# write come back empty. STATE_JQ runs on each page of comments: a "page" line, then a line per
# state comment on it ("-" if its JSON doesn't parse).
STATE_JQ='"page", (.[] | select(.user.login == "github-actions[bot]") | (.body // "")
  | select(contains("<!-- bouncer:state "))
  | (split("<!-- bouncer:state ")[1] | split(" -->")[0] | try fromjson catch null)
  | if type != "object" then "-" else
      [.status, .sha, .deadline, .left, .report, .model, .effort, .note, .base,
       (if (.reasons | type) == "array" then .reasons | map(tostring) | join("\u001f") else "" end)]
      | map(if . == null then "" else tostring end | gsub("[\\t\\r\\n]+"; " ") | if . == "" then "-" else . end)
      | join("\t")
    end)'
# The state comment that counts is the one the gate reads and updates (find_state in the
# action's bouncer/render.py): the first one on the first page of comments, or else the first
# one on the last page that has any.
pick_state() {  # reads to the end, so gh never writes to a closed pipe
  awk '$0 == "page" { page++; seen = 0; next }
    seen { next }
    { seen = 1 }
    page == 1 { first = $0; next }
    { last = $0 }
    END { if (first != "") print first; else if (last != "") print last }'
}
load_state() {
  local line v
  line="$(api "repos/$UPSTREAM/issues/$NUMBER/comments?per_page=100" --paginate --jq "$STATE_JQ" | pick_state)" || return $?
  IFS=$'\t' read -r B_STATUS B_SHA B_DEADLINE B_LEFT B_REPORT B_MODEL B_EFFORT B_NOTE B_BASE B_REASONS <<<"$line"
  for v in B_STATUS B_SHA B_DEADLINE B_LEFT B_REPORT B_MODEL B_EFFORT B_NOTE B_BASE B_REASONS; do
    [ "${!v}" != "-" ] || printf -v "$v" '%s' ""
  done
}
known_status() { case "$1" in pending|pass|fail|expired|exhausted|override|wrong_base|draft|no_fork) return 0 ;; esac; return 1; }
fmt_time() { printf '%s' "$1" | sed 's/T\([0-9][0-9]:[0-9][0-9]\).*/ \1 UTC/'; }
attempts_left() { [ -z "$B_LEFT" ] || printf ' (%s left)' "$(plural "$B_LEFT" "review attempt")"; }
show_reasons() {
  [ -n "$B_REASONS" ] || return 0
  local r reasons
  IFS=$'\x1f' read -r -a reasons <<<"$B_REASONS"
  say ""
  for r in "${reasons[@]}"; do [ -z "$r" ] || say "  • $r"; done
}
show_report() { [ -z "$B_REPORT" ] || { say ""; gray "Full review: $B_REPORT"; }; }
no_attempts_left() { say "No review attempts left. A maintainer can still reopen it if they'd like to take a look."; }
# How to try again after a bounce closed the pull request.
retry_steps() {
  [ "$B_LEFT" != 0 ] || { no_attempts_left; return 0; }
  say "To try again$(attempts_left):"
  if [ "$B_SHA" = "$HEAD_SHA" ]; then
    say "  1. Push your fixes as new commits. Don't force-push: GitHub can't reopen a pull request"
    say "     whose branch was force-pushed while it was closed."
    say "  2. Reopen the pull request."
    say "  3. Run gh bouncer $PR_URL"
  else
    say "  1. Reopen the pull request (you've already pushed new commits)."
    say "  2. Run gh bouncer $PR_URL"
  fi
}
wrong_base() {  # <is the pull request closed: yes|no>
  local what="its base branch${B_BASE:+ ($B_BASE)} isn't one this project takes outside pull requests into."
  if [ "$1" = yes ]; then
    die "$REF was closed because $what" "Open a new pull request against the right branch. A closed pull request's base can't be changed."
  fi
  die "$REF was bounced: $what" "Change its base branch as the bouncer's comment on $PR_URL explains."
}
note_explained() {  # why a signed review of this commit doesn't count
  case "$1" in
    config_changed) printf '%s' "the maintainers changed the bouncer settings after it ran" ;;
    outdated) printf '%s' "it was made with a version of the bouncer review that the project's bouncer doesn't accept" ;;
  esac
}

load_pr || gh_failed $? "Pull request $REF doesn't exist, or you can't see it." "Check the URL and try again."
load_state || gh_failed $?
STATE_NOW=""   # the bouncer's state is about the pull request's current commit
if [ -n "$B_SHA" ] && [ "$B_SHA" = "$HEAD_SHA" ]; then STATE_NOW=1; fi

# --- before spending anything: is there a review to run? ------------------------------
if [ "$PR_MERGED" = "true" ]; then ok "$REF is already merged. Nothing to do."; exit 0; fi
if [ "$PR_STATE" != "open" ]; then
  case "$B_STATUS" in
    fail)
      bad "$REF was bounced and closed."
      show_reasons
      show_report
      say ""
      retry_steps
      exit 1 ;;
    exhausted) die "$REF used all its review attempts and was closed." "A maintainer can still reopen it if they'd like to take a look." ;;
    expired)
      [ "$B_LEFT" != 0 ] || die "$REF was closed: no review arrived before the deadline, and it has no review attempts left." \
        "A maintainer can still reopen it if they'd like to take a look."
      die "$REF was closed because no review arrived before the deadline." "Reopen it, then run gh bouncer $PR_URL" ;;
    wrong_base) wrong_base yes ;;
    *) die "$REF is closed." "Reopen it, then run gh bouncer again." ;;
  esac
fi
[ -n "$HEAD_REPO" ] || die "The fork behind $REF was deleted, so it can't be reviewed."
if [ "$(lower "$HEAD_REPO")" = "$(lower "$UPSTREAM")" ]; then
  ok "$REF comes from a branch in $UPSTREAM, not a fork, so it doesn't need a bouncer review."
  exit 0
fi
if has_label bouncer:skip; then
  ok "A maintainer labeled $REF bouncer:skip, so it doesn't need a bouncer review."
  exit 0
fi
if [ -n "$STATE_NOW" ]; then
  case "$B_STATUS" in
    pass)
      ok "$REF already passed the bouncer review. Nothing to do."
      [ -z "$B_REPORT" ] || gray "Review: $B_REPORT"
      exit 0 ;;
    override) ok "A maintainer set the bouncer's verdict aside for $REF. Nothing to do."; exit 0 ;;
    fail)
      bad "$REF was bounced. It stays open for a maintainer to confirm."
      show_reasons
      show_report
      say ""
      if [ "$B_LEFT" = 0 ]; then no_attempts_left; else say "To try again$(attempts_left): push your fixes as new commits, then run gh bouncer again."; fi
      exit 1 ;;
    exhausted) die "$REF has used all its review attempts." "A maintainer can still take a look if they'd like." ;;
    wrong_base) wrong_base no ;;
    draft)
      ok "$REF is a draft, so the bouncer isn't asking for a review yet."
      gray "Mark it ready for review when it's done, then run gh bouncer $PR_URL"
      exit 0 ;;
    no_fork) die "$REF's fork was deleted, so it can't be reviewed." "To send this change again, open a new pull request from a fork." ;;
  esac
fi
if has_label bouncer:pass; then
  ok "$REF already passed the bouncer review. Nothing to do."
  if [ -n "$B_SHA" ] && [ -z "$STATE_NOW" ]; then
    gray "That was for an earlier commit. If the bouncer asks for a new review of your latest one, run gh bouncer again."
  fi
  exit 0
fi
if has_label bouncer:fail; then
  warn "The bouncer hasn't caught up with $REF's latest commit yet."
  gray "Wait a minute, then run gh bouncer again."
  exit 0
fi
if ! has_label bouncer:pending; then
  warn "$REF isn't waiting for a bouncer review, so there's nothing to run."
  gray "Its author may be exempt, or the bouncer hasn't seen it yet. If you just opened it, wait a minute and try again."
  exit 0
fi
if [ -n "$B_STATUS" ] && ! known_status "$B_STATUS"; then
  warn "The bouncer says \"$B_STATUS\" about $REF, which this version of gh bouncer doesn't know. Going ahead as if it's waiting for a review."
  gray "Updating may help: gh extension upgrade bouncer"
fi
NOTE=""   # why the last signed review of this commit didn't count, if the bouncer said so
[ -z "$STATE_NOW" ] || NOTE="$B_NOTE"

# --- your fork -------------------------------------------------------------------------
fork="$(api "repos/$HEAD_REPO" --jq '[(.permissions.admin // false), .default_branch, (.parent.full_name // "")]
  | map(tostring | if . == "" then "-" else . end) | join("\t")')" ||
  gh_failed $? "You can't see $HEAD_REPO, the fork $REF was opened from." "Only the pull request's author can run its review."
IFS=$'\t' read -r IS_ADMIN DEFAULT_BRANCH FORK_PARENT <<<"$fork"
[ "$FORK_PARENT" != "-" ] || FORK_PARENT=""
[ "$IS_ADMIN" = "true" ] ||
  die "You need admin rights on $HEAD_REPO, the fork $REF was opened from." "Only the pull request's author can run its review."
direct_fork() { [ "$(lower "$FORK_PARENT")" = "$(lower "$UPSTREAM")" ]; }

say "Reviewing $REF from $HEAD_REPO"
if [ -n "$STATE_NOW" ] && [ "$B_STATUS" = "pending" ] && [ -n "$B_DEADLINE" ]; then
  gray "Deadline $(fmt_time "$B_DEADLINE")${B_LEFT:+ · $(plural "$B_LEFT" "review attempt") left}"
fi
case "$NOTE" in
  config_changed|outdated) warn "Your last review of this commit doesn't count: $(note_explained "$NOTE"). Running a new one doesn't use up a review attempt." ;;
  verify_error) warn "The bouncer couldn't verify the signed review of this commit." ;;
esac

# has_workflow <branch>: does the fork have the bouncer workflow on that branch?
has_workflow() {
  local rc=0
  api -X GET "repos/$HEAD_REPO/contents/$WORKFLOW_PATH" -f ref="$1" --jq .path >/dev/null || rc=$?
  [ "$rc" != 0 ] || return 0
  is_404 && return 1
  gh_failed "$rc"
}
# sync_fork <why it's needed>: bring the project's default branch into the fork's, like Sync fork
sync_fork() {
  if [ "$HEAD_REF" = "$DEFAULT_BRANCH" ]; then
    die "$1, and gh bouncer won't change $DEFAULT_BRANCH because it's your pull request's branch." \
      "Merge the latest $UPSTREAM into $HEAD_REPO:$DEFAULT_BRANCH and push, then run gh bouncer again."
  fi
  if ! direct_fork; then
    die "$1, and gh bouncer can't sync it: $HEAD_REPO is a fork of ${FORK_PARENT:-another repository}, not of $UPSTREAM." \
      "Merge $UPSTREAM's default branch into $HEAD_REPO:$DEFAULT_BRANCH and push, then run gh bouncer again."
  fi
  say "$1. Syncing $HEAD_REPO:$DEFAULT_BRANCH with $UPSTREAM..."
  local rc=0
  api -X POST "repos/$HEAD_REPO/merge-upstream" -f branch="$DEFAULT_BRANCH" >/dev/null || rc=$?
  if [ "$rc" != 0 ]; then
    reachable "$rc"
    if grep -q 'workflow.*scope' "$ERRF"; then
      die "Syncing your fork adds a workflow file, which needs the workflow scope on your gh login." \
        "Run gh auth refresh -s workflow, then gh bouncer again."
    elif grep -q 'HTTP 409' "$ERRF"; then
      die "Couldn't sync $HEAD_REPO:$DEFAULT_BRANCH: it has commits that conflict with $UPSTREAM." \
        "Merge $UPSTREAM into it and push, or use Sync fork on https://github.com/$HEAD_REPO, then run gh bouncer again."
    fi
    die "Couldn't sync $HEAD_REPO:$DEFAULT_BRANCH with $UPSTREAM: $(gh_msg)" \
      "Use Sync fork on https://github.com/$HEAD_REPO, then run gh bouncer again."
  fi
  ok "Synced $HEAD_REPO:$DEFAULT_BRANCH with $UPSTREAM (your pull request's branch wasn't touched)"
}

# Manual reviews run the workflow from the fork's default branch.
if ! has_workflow "$DEFAULT_BRANCH"; then
  sync_fork "Your fork doesn't have the bouncer workflow yet"
  has_workflow "$DEFAULT_BRANCH" || die "$UPSTREAM has no $WORKFLOW_PATH on its default branch, so there's no review to run." \
    "Bouncer may have been removed from the project. Ask its maintainers."
elif [ "$NOTE" = "outdated" ]; then
  sync_fork "Your fork's bouncer workflow may be out of date"
fi
# Reviews on push run the workflow from the pushed branch, so they need it there too.
AUTO=""
if [ "$HEAD_REF" = "$DEFAULT_BRANCH" ] || has_workflow "$HEAD_REF"; then AUTO=1; fi

# --- workflows in forks start switched off -------------------------------------------------
read_workflow_state() {  # WF_STATE: active, disabled_..., or missing
  local rc=0
  WF_STATE="$(api "repos/$HEAD_REPO/actions/workflows/$WORKFLOW" --jq .state)" || rc=$?
  [ "$rc" != 0 ] || return 0
  is_404 && { WF_STATE="missing"; return 0; }
  gh_failed "$rc"
}
read_workflow_state
if [ "$WF_STATE" = "missing" ]; then
  # GitHub takes a few seconds to register a workflow file that just arrived.
  gray "Waiting for GitHub to pick up the workflow..."
  i=0
  while [ "$WF_STATE" = "missing" ] && [ "$i" -lt 10 ]; do
    sleep "$POLL_SECONDS"
    read_workflow_state
    i=$((i + 1))
  done
  [ "$WF_STATE" != "missing" ] || die "GitHub hasn't picked up the bouncer workflow in $HEAD_REPO yet." \
    "Wait a minute, then run gh bouncer again. If it keeps happening, check https://github.com/$HEAD_REPO/actions"
fi
if [ "$WF_STATE" != "active" ]; then
  gh api -X PUT "repos/$HEAD_REPO/actions/permissions" -F enabled=true -f allowed_actions=all >/dev/null 2>&1 || true
  gh api -X PUT "repos/$HEAD_REPO/actions/workflows/$WORKFLOW/enable" >/dev/null 2>&1 || true
  read_workflow_state
  [ "$WF_STATE" = "active" ] || die "GitHub needs you to turn on Actions in your fork once, in the browser." \
    "Open https://github.com/$HEAD_REPO/actions, click \"I understand my workflows, go ahead and enable them\", then run gh bouncer again."
  ok "Turned on GitHub Actions in $HEAD_REPO"
  gray "Forks start with Actions off. The review runs there, in your fork."
fi

# --- the key lives only in the fork's secrets -------------------------------------------
ask_key() {
  local key="$ENV_KEY" from_env=1
  if [ -z "$key" ]; then
    from_env=""
    if [ ! -t 0 ]; then
      [ "$SET_KEY" = 0 ] || die "--set-key needs a terminal to ask for the key, or ANTHROPIC_API_KEY in your environment."
      die "Your fork has no ANTHROPIC_API_KEY secret yet." \
        "Set ANTHROPIC_API_KEY in your environment, or run gh bouncer in a terminal to be asked for it."
    fi
    say ""
    say "The review runs on your own Anthropic API key, saved only as an Actions secret in $HEAD_REPO."
    say "Every review is billed to your key${B_MODEL:+: this project reviews with $B_MODEL${B_EFFORT:+ at $B_EFFORT effort}}."
    [ -z "$AUTO" ] || say "When the bouncer asks for a new review after you push to this pull request, it usually starts on its own."
    gray "Get a key at $KEYS_URL"
    printf '%s?%s Anthropic API key %s(input hidden)%s ' "$C_OK" "$C_OFF" "$C_GRAY" "$C_OFF" >&2
    IFS= read -rs key || true
    printf '\n' >&2
  fi
  # Trim what a paste can bring along.
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"
  [ -n "$key" ] || die "No key entered. Your fork's secrets weren't changed." "Run gh bouncer again when you have a key."
  local valid=""
  case "$key" in *[[:space:]]*) ;; sk-ant-?*) valid=1 ;; esac
  if [ -z "$valid" ]; then
    [ -z "$from_env" ] || die "ANTHROPIC_API_KEY in your environment doesn't look like an Anthropic API key (they start with sk-ant-), so it wasn't saved." \
      "Fix it or unset it, then run gh bouncer again."
    die "That doesn't look like an Anthropic API key (they start with sk-ant-), so it wasn't saved." \
      "Copy it again from $KEYS_URL and run gh bouncer again."
  fi
  local rc=0
  printf '%s' "$key" | ghc secret set ANTHROPIC_API_KEY -R "$HEAD_REPO" >/dev/null || rc=$?
  key=""
  [ "$rc" = 0 ] || { reachable "$rc"; die "Couldn't save the key in $HEAD_REPO: $(gh_msg)"; }
  ok "Saved ANTHROPIC_API_KEY as an Actions secret in $HEAD_REPO"
  gray "Only workflows in your fork can read it. Replace it any time with gh bouncer --set-key"
  say ""
}
rc=0
has_key="$(ghc secret list -R "$HEAD_REPO" --json name --jq 'map(select(.name == "ANTHROPIC_API_KEY")) | length')" || rc=$?
if [ "$rc" != 0 ]; then
  reachable "$rc"
  if [ "$SET_KEY" = 0 ]; then
    warn "Couldn't check your fork's secrets ($(gh_msg)). Going ahead as if ANTHROPIC_API_KEY is there."
    gray "If it isn't, the review stops before using any tokens and says so."
    has_key=1
  fi
fi
if [ "$has_key" = "0" ] || [ "$SET_KEY" = 1 ]; then ask_key; fi

# --- start the review, or follow one that's already running ---------------------------
# Only the first signed review of a commit counts, and each one is billed to your key, so
# don't start another while one is running or after one is done. Reviews on push are found
# by commit; manual ones are named "Bouncer review · PR #N".
RUN_JQ='.[] | [.databaseId, .status, .conclusion, .event, .displayTitle]
  | map(tostring | gsub("[\\t\\r\\n]+"; " ") | if . == "" then "-" else . end) | join("\t")'
RUN_ID=""
RUN_HOW=""      # started, running (someone else's run of this commit), signed (finished and signed)
LAST_DISPATCH=0 # the newest manual run before ours
is_ours() { [ "$1" = "push" ] || [[ "$2" == *"PR #$NUMBER" ]]; }
# read_run <run id>: R_CONCLUSION, R_FAILED_JOBS (comma-separated), R_SIGNED (non-empty if signed)
RUN_VIEW_JQ='[.conclusion, ([.jobs[] | select(.conclusion == "failure") | .databaseId | tostring] | join(",")),
  ([.jobs[].steps[]? | select((.name | startswith("Sign")) and .conclusion == "success")] | length | tostring)]
  | map(if . == "" or . == null then "-" else . end) | join("\t")'
read_run() {
  local info
  info="$(ghc run view "$1" -R "$HEAD_REPO" --json conclusion,jobs --jq "$RUN_VIEW_JQ" </dev/null)" || return $?
  IFS=$'\t' read -r R_CONCLUSION R_FAILED_JOBS R_SIGNED <<<"$info"
  [ "$R_CONCLUSION" != "-" ] || R_CONCLUSION=""
  [ "$R_FAILED_JOBS" != "-" ] || R_FAILED_JOBS=""
  [ "$R_SIGNED" != "0" ] || R_SIGNED=""
}
find_review() {
  local by_commit manual id status conclusion event title rc
  by_commit="$(ghc run list -R "$HEAD_REPO" -w "$WORKFLOW" --commit "$HEAD_SHA" -L 20 \
    --json databaseId,status,conclusion,event,displayTitle --jq "$RUN_JQ")" || gh_failed $?
  manual="$(ghc run list -R "$HEAD_REPO" -w "$WORKFLOW" -e workflow_dispatch -L 20 \
    --json databaseId,status,conclusion,event,displayTitle --jq "$RUN_JQ")" || gh_failed $?
  while IFS=$'\t' read -r id status conclusion event title; do
    [ -n "$id" ] || continue
    if [ "$event" = "workflow_dispatch" ] && [ "$id" -gt "$LAST_DISPATCH" ]; then LAST_DISPATCH="$id"; fi
    if [ "$status" != "completed" ] && is_ours "$event" "$title"; then
      RUN_ID="$id" RUN_HOW="running"
      return 0
    fi
  done <<<"$by_commit"$'\n'"$manual"
  # A finished, signed review of this commit, unless the bouncer said it doesn't count.
  case "$NOTE" in config_changed|outdated) return 0 ;; esac
  while IFS=$'\t' read -r id status conclusion event title; do
    if [ "$event" != "push" ] || [ "$conclusion" != "success" ]; then continue; fi
    rc=0
    read_run "$id" || rc=$?
    [ "$rc" = 0 ] || gh_failed "$rc"
    if [ -n "$R_SIGNED" ]; then
      RUN_ID="$id" RUN_HOW="signed"
      return 0
    fi
  done <<<"$by_commit"
}
# has_attestation: does the fork already have a signed review of this commit, from any run (a
# manual one, or one too old to be listed)? GitHub indexes attestations by the SHA-256 of their
# subject, which every review of a pull request's commit shares (subject_name in the action's
# bouncer/common.py). A 404 means there's none.
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d ' ' -f 1; }
has_attestation() {
  local digest count rc=0
  digest="$(printf '%s' "bouncer-review/v1 $(lower "$UPSTREAM")#$NUMBER@$(lower "$HEAD_SHA")" | sha256)"
  count="$(api "repos/$HEAD_REPO/attestations/sha256:$digest?per_page=1" --jq '.attestations | length')" || rc=$?
  if [ "$rc" != 0 ]; then
    is_404 || warn "Couldn't check whether your fork already has a signed review of this commit ($(gh_msg)). Starting one."
    return 1
  fi
  case "$count" in ''|0|*[!0-9]*) return 1 ;; esac
}
newest_dispatch() {
  ghc run list -R "$HEAD_REPO" -w "$WORKFLOW" -e workflow_dispatch -L 20 --json databaseId \
    --jq 'map(.databaseId) | max // 0' || echo 0
}
start_review() {
  local before="$LAST_DISPATCH" resp rc=0
  local args=(-X POST "repos/$HEAD_REPO/actions/workflows/$WORKFLOW/dispatches" -f ref="$DEFAULT_BRANCH" -f "inputs[pr]=$NUMBER")
  resp="$(api "${args[@]}" -f "inputs[upstream]=$UPSTREAM" -F return_run_details=true)" || rc=$?
  if [ "$rc" != 0 ] && grep -q 'Unexpected inputs' "$ERRF" && grep -q 'upstream' "$ERRF"; then
    # A workflow from before the upstream input. Fine when the fork comes straight from the project.
    direct_fork || die "Your fork's bouncer workflow is too old to review a pull request from a fork of a fork." \
      "Merge the latest $UPSTREAM into $HEAD_REPO:$DEFAULT_BRANCH and push, then run gh bouncer again." \
      "If that doesn't help, the project's bouncer needs an update. Ask its maintainers."
    rc=0
    resp="$(api "${args[@]}" -F return_run_details=true)" || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    reachable "$rc"
    if grep -q "workflow_dispatch" "$ERRF"; then
      die "The bouncer workflow on $HEAD_REPO:$DEFAULT_BRANCH is out of date, so gh bouncer can't start it." \
        "Use Sync fork on https://github.com/$HEAD_REPO, then run gh bouncer again."
    fi
    die "GitHub wouldn't start the review: $(gh_msg)" "See https://github.com/$HEAD_REPO/actions/workflows/$WORKFLOW"
  fi
  RUN_ID="$(printf '%s' "$resp" | sed -n 's/.*"workflow_run_id":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)"
  local i=0 now
  while [ -z "$RUN_ID" ] && [ "$i" -lt 10 ]; do
    sleep "$POLL_SECONDS"
    now="$(newest_dispatch)"
    if [ "$now" -gt "$before" ]; then RUN_ID="$now"; fi
    i=$((i + 1))
  done
  [ -n "$RUN_ID" ] || die "The review started, but its run didn't show up yet." \
    "Follow it at https://github.com/$HEAD_REPO/actions/workflows/$WORKFLOW"
  RUN_HOW="started"
  ok "Started the review"
}

stopped_watching() {
  say ""
  warn "Stopped watching. The review is still running: $RUN_URL"
  gray "The bouncer posts the result on $PR_URL within about 10 minutes of it finishing."
  exit 2
}
EXPLAINED=""
watch_run() {
  RUN_URL="https://github.com/$HEAD_REPO/actions/runs/$RUN_ID"
  gray "$RUN_URL"
  if [ -z "$EXPLAINED" ]; then
    say ""
    say "Reviews usually take a few minutes. Ctrl-C stops watching; the review keeps running"
    say "and the bouncer still posts the result on the pull request."
    say ""
    EXPLAINED=1
  fi
  trap stopped_watching INT
  gh run watch "$RUN_ID" -R "$HEAD_REPO" --interval 10 >&2 || true
  trap - INT
}
run_failed() {
  local why="" job msg
  [ "$R_CONCLUSION" != "cancelled" ] || die "The review was cancelled before it was signed, so it doesn't count." \
    "Nothing was signed, so this doesn't use up a review attempt." "Run gh bouncer $PR_URL to start a new one."
  [ "$R_CONCLUSION" != "timed_out" ] || why="it ran out of time"
  # The review explains what went wrong (key, credits, rate limits...) in an error annotation.
  for job in ${R_FAILED_JOBS//,/ }; do
    msg="$(api "repos/$HEAD_REPO/check-runs/$job/annotations" --jq '.[] | select(.annotation_level == "failure")
      | .message | select(startswith("Process completed with exit code") | not)' | head -n 1)" || true
    if [ -n "$msg" ]; then why="$msg"; break; fi
  done
  die "The review didn't finish${why:+: $why}" "Nothing was signed, so this doesn't use up a review attempt." \
    "Logs: gh run view $RUN_ID -R $HEAD_REPO --log-failed"
}

find_review
# Not even a finished run? Then look for the signed review itself, unless the bouncer said the
# last one doesn't count.
case "$RUN_HOW:$NOTE" in
  :config_changed|:outdated) ;;
  :*) if has_attestation; then RUN_HOW="attested"; fi ;;
esac
case "$RUN_HOW" in
  running) ok "A review of this commit is already running in your fork. Following it instead of starting another." ;;
  signed)
    ok "Your fork already reviewed this commit, and GitHub signed it."
    gray "https://github.com/$HEAD_REPO/actions/runs/$RUN_ID" ;;
  attested)
    ok "Your fork already has a signed review of this commit, so gh bouncer isn't starting another."
    gray "Only the first signed review of a commit counts."
    RUN_HOW="signed" ;;
  *) start_review ;;
esac
while [ "$RUN_HOW" != "signed" ]; do
  if [ "$WATCH" = 0 ]; then
    gray "https://github.com/$HEAD_REPO/actions/runs/$RUN_ID"
    gray "The bouncer posts the result on $PR_URL within about 10 minutes of the review finishing."
    exit 0
  fi
  watch_run
  rc=0
  read_run "$RUN_ID" || rc=$?
  say ""
  if [ "$rc" != 0 ]; then
    reachable "$rc"
    die "Couldn't tell how the review ended: $(gh_msg)" "See $RUN_URL. If it finished, the bouncer posts the result on $PR_URL."
  fi
  if [ "$R_CONCLUSION" = "success" ] && [ -z "$R_SIGNED" ] && [ "$RUN_HOW" = "running" ]; then
    # An automatic run with nothing to do, e.g. one that started before your key was saved.
    warn "That run didn't review your pull request, so gh bouncer is starting a review."
    start_review
    continue
  fi
  if [ "$R_CONCLUSION" != "success" ] && [ -z "$R_SIGNED" ]; then run_failed; fi
  [ "$R_CONCLUSION" = "success" ] || warn "A step after signing failed, but the review was signed, so it counts."
  ok "Review finished and signed by GitHub"
  RUN_HOW="signed"
done

# --- the result comes from the project's bouncer, once it has verified the signature -----------
ghc pr comment "$NUMBER" -R "$UPSTREAM" --body "/bouncer check" >/dev/null ||
  warn "Couldn't ask the bouncer to check right away. It checks every 10 minutes on its own."
if [ "$WATCH" = 0 ]; then
  gray "The bouncer posts the result on $PR_URL"
  exit 0
fi
stopped_waiting() {
  say ""
  warn "Stopped waiting. The bouncer posts the result on $PR_URL"
  exit 2
}
say "Waiting for the bouncer to verify the review and post the result..."
trap stopped_waiting INT
RESULT=""   # the bouncer's status for this commit, once it isn't pending
i=0
while [ "$i" -lt "$VERDICT_TRIES" ]; do
  [ "$i" = 0 ] || sleep "$VERDICT_SECONDS"
  i=$((i + 1))
  load_state || continue
  [ "$B_SHA" = "$HEAD_SHA" ] || continue
  # A new note means the bouncer looked and the review doesn't count. Unknown statuses: keep waiting.
  if [ "$B_STATUS" = "pending" ] && [ -n "$B_NOTE" ] && [ "$B_NOTE" != "$NOTE" ]; then RESULT="note"; break; fi
  if [ "$B_STATUS" != "pending" ] && known_status "$B_STATUS"; then RESULT="$B_STATUS"; break; fi
done
trap - INT
say ""

auto_note() {
  if [ -n "$AUTO" ]; then
    gray "New commits you push to this pull request are usually reviewed automatically, on your key."
    gray "If the bouncer still asks for a review after a push, run gh bouncer again."
  else
    gray "Your branch $HEAD_REF doesn't have the bouncer workflow, so new commits aren't reviewed automatically."
    gray "Merge the latest $UPSTREAM into it to change that, or run gh bouncer again after each push."
  fi
}
# The bouncer closes a bounced pull request right after saving its verdict, unless the project
# keeps them open, so give it a moment.
pr_closed_now() {
  local state="open" i=0
  while [ "$state" = "open" ] && [ "$i" -lt 3 ]; do
    [ "$i" = 0 ] || sleep "$POLL_SECONDS"
    state="$(api "repos/$UPSTREAM/pulls/$NUMBER" --jq .state || echo open)"
    i=$((i + 1))
  done
  [ "$state" != "open" ]
}
case "$RESULT" in
  pass|override)
    ok "${C_BOLD}Passed.${C_OFF} $REF is ready for a maintainer."
    [ -z "$B_REPORT" ] || gray "Review: $B_REPORT"
    auto_note
    exit 0 ;;
  fail)
    closed=""
    if pr_closed_now; then
      closed=1
      bad "${C_BOLD}Bounced.${C_OFF} $REF was closed."
    else
      bad "${C_BOLD}Bounced.${C_OFF} $REF stays open for a maintainer to confirm."
    fi
    show_reasons
    show_report
    say ""
    if [ -n "$closed" ]; then
      retry_steps
    elif [ "$B_LEFT" = 0 ]; then
      no_attempts_left
    elif [ -n "$AUTO" ]; then
      say "To try again$(attempts_left): push your fixes as new commits. A new review usually starts on your key"
      say "automatically. If the bouncer still asks for one, run gh bouncer again."
    else
      say "To try again$(attempts_left): push your fixes as new commits, then run gh bouncer again."
    fi
    exit 1 ;;
  exhausted) die "$REF used all its review attempts and was closed." "A maintainer can still reopen it if they'd like to take a look." ;;
  expired) die "$REF was closed: the deadline passed before the bouncer saw the review." \
    "Reopen it, and the bouncer checks the review you just ran." ;;
  wrong_base) if pr_closed_now; then wrong_base yes; else wrong_base no; fi ;;
  note)
    case "$B_NOTE" in
      config_changed) die "Your review doesn't count: $(note_explained "$B_NOTE")." \
        "Run gh bouncer $PR_URL again. This doesn't use up a review attempt." ;;
      outdated) die "Your review doesn't count: $(note_explained "$B_NOTE")." \
        "Run gh bouncer $PR_URL again: it syncs your fork first. This doesn't use up a review attempt." \
        "If it happens again after that, let the project's maintainers know: their bouncer may be pinned to an older version." ;;
      verify_error) warn "The bouncer couldn't verify your signed review yet. It tries again every 10 minutes." ;;
      *) warn "The bouncer hasn't posted the result yet. It says: $B_NOTE" ;;
    esac ;;
  *)
    if [ "$B_SHA" = "$HEAD_SHA" ] && [ -n "$B_STATUS" ] && ! known_status "$B_STATUS"; then
      warn "The bouncer says \"$B_STATUS\", which this version of gh bouncer doesn't know."
      gray "Updating may help: gh extension upgrade bouncer"
    else
      warn "The bouncer hasn't posted the result yet. It checks every 10 minutes."
    fi ;;
esac
gray "The result will appear on $PR_URL"
