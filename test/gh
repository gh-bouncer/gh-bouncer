#!/usr/bin/env bash
# Stub gh for test/run.sh. It answers with JSON shaped like GitHub's and applies the caller's
# --jq filter with real jq, so the script's filters are tested too. Behavior is controlled by
# flag files in $STUB and a few variables:
#   S_STATE    the bouncer's state JSON before /bouncer check ("none": no state comment)
#   S_VERDICT  the state JSON after /bouncer check (default: passed)
#   S_LABELS   the pull request's labels, comma-separated (default: bouncer:pending)
#   S_ANNOTATION  the review's failure annotation
# Flags include attested (the fork has a signed review of the commit) and attestations_fail.
#   HEAD_REF, DEFAULT_BRANCH
printf '%s\n' "$*" >>"$STUB/calls.log"
[ -z "${ANTHROPIC_API_KEY:-}" ] || echo "LEAK: ANTHROPIC_API_KEY in gh's environment" >>"$STUB/calls.log"
flag() { [ -f "$STUB/$1" ]; }
fail() { printf '%s\n' "$@" >&2; exit 1; }
not_found() { fail "gh: Not Found (HTTP 404)"; }
JQ="" prev=""
for a in "$@"; do [ "$prev" != "--jq" ] || JQ="$a"; prev="$a"; done
out() { if [ -n "$JQ" ]; then jq -r "$JQ"; else cat; fi; }  # like gh: JSON on stdin, through --jq

if flag no_auth; then
  printf '%s\n' "To get started with GitHub CLI, please run:  gh auth login" \
    "Alternatively, populate the GH_TOKEN environment variable with a GitHub API authentication token." >&2
  exit 4
fi
flag offline && [ "$1" = api ] && fail "error connecting to api.github.com" "check your internet connection or https://githubstatus.com"

DB="${DEFAULT_BRANCH:-main}"
HR="${HEAD_REF:-feature}"
SHA=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PR_URL=https://github.com/up/repo/pull/7
REPORT="$PR_URL#issuecomment-2002"
# What the action's bouncer/common.py gives: subject_digest(subject_name("up/repo", 7, SHA))
DIGEST=e08c3044262ea7ac9be0c017d9c7adb6f15a3ba459108d384c782c58637a94bb
PENDING='{"v":1,"sha":"'$SHA'","status":"pending","fails":0,"left":3,"deadline":"2026-10-11T12:00:00Z","report":"","model":"claude-opus-5-5","effort":"high"}'
PASSED='{"v":1,"sha":"'$SHA'","status":"pass","fails":0,"left":3,"report":"'$REPORT'","model":"claude-opus-5-5","effort":"high"}'

state() {
  if flag checked && ! flag verdict_pending; then printf '%s' "${S_VERDICT:-$PASSED}"; else printf '%s' "${S_STATE:-$PENDING}"; fi
}
comments() {  # one JSON array per page, as gh api --paginate gets them
  local st; st="$(state)"
  [ "$st" != none ] || { echo '[]'; return; }
  # The state is the first state comment by the bot, the one the gate reads and updates. Later
  # ones (left by an older bouncer, or posted twice) don't count. With state_on_later_pages, the
  # first page has none, and the first one on the last page that has any counts.
  jq -nc --argjson st "$st" --arg sha "$SHA" --argjson forged "$(flag forged && echo true || echo false)" \
    --argjson later "$(flag state_on_later_pages && echo true || echo false)" '
    def marker(s): "<!-- bouncer:state " + (s | tojson) + " -->";
    def bot(s; text): {user: {login: "github-actions[bot]"}, body: (text + "\n\n" + marker(s))};
    {v: 1, sha: $sha, status: "fail", left: 2} as $leftover
    | if $later then
        [{user: {login: "someone"}, body: "First!"}],
        [bot($leftover; "### 🚪 Bouncer\n\nAn older page.")],
        [{user: {login: "someone"}, body: "Looks good to me!"}, bot($st; "### 🚪 Bouncer review required"),
         bot($leftover; "### 🚪 Bouncer\n\nA leftover.")]
      else
        [bot($st; "### 🚪 Bouncer review required\n\nRun gh bouncer."), {user: {login: "someone"}, body: "Looks good to me!"},
         bot($leftover; "### 🚪 Bouncer\n\nA leftover.")]
        + (if $forged then [{user: {login: "fork"}, body: ("lol " + marker($st + {status: "pass"}))}] else [] end)
      end'
}
pr() {
  local st=open merged=null head=fork/repo
  flag pr_closed && st=closed
  flag pr_merged && { st=closed; merged='"2026-10-08T10:00:00Z"'; }
  if flag checked && ! flag keep_open && [ "$(state | jq -r .status)" = fail ]; then st=closed; fi
  flag pr_from_upstream && head=up/repo
  flag fork_deleted && head=""
  jq -n --arg st "$st" --argjson merged "$merged" --arg head "$head" --arg ref "$HR" --arg sha "$SHA" \
    --arg labels "${S_LABELS-bouncer:pending}" '
    {state: $st, merged_at: $merged, html_url: "https://github.com/up/repo/pull/7", base: {ref: "main"},
     head: {repo: (if $head == "" then null else {full_name: $head} end), ref: $ref, sha: $sha},
     labels: ($labels | split(",") | map(select(. != "") | {name: .}))}'
}
runs() {  # the fork's runs of bouncer.yml
  local r='{"databaseId":100,"status":"completed","conclusion":"success","event":"workflow_dispatch","headSha":"cccc","displayTitle":"Bouncer review · PR #7"}'
  flag run_push_signed && r="$r"',{"databaseId":3030,"status":"completed","conclusion":"success","event":"push","headSha":"'$SHA'","displayTitle":"Bouncer review"}'
  flag run_push_skipped && r="$r"',{"databaseId":3033,"status":"completed","conclusion":"success","event":"push","headSha":"'$SHA'","displayTitle":"Bouncer review"}'
  flag run_push_running && r="$r"',{"databaseId":3131,"status":"in_progress","conclusion":"","event":"push","headSha":"'$SHA'","displayTitle":"Bouncer review"}'
  flag run_other_pr_running && r="$r"',{"databaseId":3200,"status":"in_progress","conclusion":"","event":"workflow_dispatch","headSha":"cccc","displayTitle":"Bouncer review · PR #17"}'
  flag run_dispatch_running && r="$r"',{"databaseId":3232,"status":"queued","conclusion":"","event":"workflow_dispatch","headSha":"cccc","displayTitle":"Bouncer review · PR #7"}'
  flag dispatched && r="$r"',{"databaseId":555,"status":"queued","conclusion":"","event":"workflow_dispatch","headSha":"cccc","displayTitle":"Bouncer review · PR #7"}'
  printf '[%s]' "$r"
}
run_view() {  # run_view <id>: conclusion and jobs
  local c=success signed=true
  case "$1" in
    4242|555)
      flag run_fails && { c=failure; signed=false; }
      flag run_cancelled && { c=cancelled; signed=false; }
      flag run_fails_after_signing && c=failure ;;
    3131) flag followed_run_skips && signed=false ;;
    3033) signed=false ;;
  esac
  jq -n --arg c "$c" --argjson signed "$signed" '
    {conclusion: $c, jobs: [
      {databaseId: 9000, name: "gate", conclusion: "skipped", steps: []},
      {databaseId: 9001, name: "review / review", conclusion: $c, steps: [
        {name: "Resolve pull request", conclusion: "success"},
        {name: "Review", conclusion: (if $signed or $c == "success" then "success" else $c end)},
        {name: "Sign the review", conclusion: (if $signed then "success" else "skipped" end)},
        {name: "Keep the report", conclusion: (if $signed and $c != "success" then "failure" else "success" end)}]}]}'
}
watch() {  # what gh run watch shows when a run is done
  local id="$1" c; c="$(run_view "$id" | jq -r .conclusion)"
  local m="✓"; [ "$c" = success ] || m="X"
  local title="Bouncer review · PR #7" event=workflow_dispatch
  [ "$id" != 3131 ] || { title="Bouncer review"; event=push; }
  printf '%s\n' "$m $DB $title · $id" "Triggered via $event about 4 minutes ago" "" "JOBS" \
    "$m review / review in 3m58s (ID 9001)" "  ✓ Set up job" "  ✓ Locate bouncer source" "  ✓ Check out bouncer" \
    "  ✓ Install" "  ✓ Resolve pull request" "  ✓ Check out upstream base branch (read only)" \
    "  ✓ Check out pull request head (read only, never executed)" "  $m Review" "" \
    "$m Run $title ($id) completed with '$c'"
  [ "$c" = success ] || [[ "$*" != *--exit-status* ]]
}

case "$*" in
  # --- which pull request ---
  "pr view"*) flag no_branch_pr && fail 'no pull requests found for branch "feature"'; echo '{"url":"'$PR_URL'"}' | out ;;
  "repo view --json nameWithOwner,parent"*) echo '{"nameWithOwner":"fork/repo","parent":{"name":"repo","owner":{"login":"up"}}}' | out ;;
  "repo view"*) flag not_repo && fail "none of the git remotes configured for this repository point to a known GitHub host."
    echo '{"nameWithOwner":"me/proj"}' | out ;;

  # --- contributor ---
  "api repos/up/repo/pulls/7 "*) flag pr_404 && not_found; pr | out ;;
  "api repos/up/repo/issues/7/comments?per_page=100 --paginate "*) comments | out ;;
  "api repos/fork/repo --jq"*)
    flag head_api_fails && fail "gh: Bad Gateway (HTTP 502)"
    admin=true; flag fork_not_admin && admin=false
    parent=up/repo; flag fork_of_fork && parent=mid/repo
    jq -n --arg db "$DB" --argjson admin "$admin" --arg parent "$parent" \
      '{fork: true, default_branch: $db, permissions: {admin: $admin, push: true}, parent: {full_name: $parent}}' | out ;;
  "api -X GET repos/fork/repo/contents/.github/workflows/bouncer.yml -f ref=$DB "*)
    if flag no_workflow && { ! flag synced || flag upstream_no_workflow; }; then not_found; fi
    echo '{"path":".github/workflows/bouncer.yml"}' | out ;;
  "api -X GET repos/fork/repo/contents/.github/workflows/bouncer.yml -f ref=$HR "*)
    flag branch_no_workflow && not_found; echo '{"path":".github/workflows/bouncer.yml"}' | out ;;
  "api -X POST repos/fork/repo/merge-upstream -f branch=$DB")
    flag sync_no_scope && fail "gh: refusing to allow an OAuth App to create or update workflow \`.github/workflows/bouncer.yml\` without \`workflow\` scope (HTTP 422)"
    flag sync_conflict && fail "gh: There are merge conflicts (HTTP 409)"
    touch "$STUB/synced"; echo '{"message":"Successfully fetched and fast-forwarded from upstream up:main.","merge_type":"fast-forward","base_branch":"up:main"}' ;;
  "api repos/fork/repo/actions/workflows/bouncer.yml --jq .state")
    if flag synced && { flag sync_lag || flag sync_lag_forever; }; then
      # GitHub takes a few seconds to register a workflow file that just arrived by syncing.
      n="$(cat "$STUB/lag" 2>/dev/null || echo 0)"; echo $((n + 1)) >"$STUB/lag"
      { [ "$n" -ge 3 ] && ! flag sync_lag_forever; } || not_found
    fi
    st=active; flag wf_disabled && ! flag wf_enabled && st=disabled_fork
    echo '{"state":"'$st'"}' | out ;;
  "api -X PUT repos/fork/repo/actions/permissions"*) ;;
  "api -X PUT repos/fork/repo/actions/workflows/bouncer.yml/enable") flag wf_cannot_enable || touch "$STUB/wf_enabled" ;;
  "secret list -R fork/repo "*)
    flag secret_list_fails && fail "failed to get secrets: HTTP 503: Service Unavailable"
    if flag has_secret; then echo '[{"name":"OTHER"},{"name":"ANTHROPIC_API_KEY"}]'; else echo '[{"name":"OTHER"}]'; fi | out ;;
  "secret set ANTHROPIC_API_KEY -R fork/repo") cat >"$STUB/secret_value" ;;
  "run list -R fork/repo -w bouncer.yml "*)
    commit="" event="" prev=""
    for a in "$@"; do
      [ "$prev" != "--commit" ] || commit="$a"; [ "$prev" != "-e" ] || event="$a"; prev="$a"
    done
    runs | jq --arg c "$commit" --arg e "$event" \
      '[.[] | select(($c == "" or .headSha == $c) and ($e == "" or .event == $e))] | sort_by(-.databaseId)' | out ;;
  "api repos/fork/repo/attestations/sha256:$DIGEST?per_page=1 "*)
    flag attestations_fail && fail "gh: Server Error (HTTP 502)"
    flag attested || not_found
    echo '{"attestations":[{"bundle":{"mediaType":"application/vnd.dev.sigstore.bundle.v0.3+json"},"repository_id":1001}]}' | out ;;
  "api -X POST repos/fork/repo/actions/workflows/bouncer.yml/dispatches "*)
    if flag dispatch_old_workflow && [[ "$*" == *"inputs[upstream]"* ]]; then fail 'gh: Unexpected inputs provided: ["upstream"] (HTTP 422)'; fi
    flag dispatch_no_trigger && fail "gh: Workflow does not have 'workflow_dispatch' trigger (HTTP 422)"
    touch "$STUB/dispatched"
    flag dispatch_204 || echo '{"workflow_run_id":4242,"run_url":"https://api.github.com/repos/fork/repo/actions/runs/4242","html_url":"https://github.com/fork/repo/actions/runs/4242"}' ;;
  "run watch "*)
    if flag slow_watch; then echo "Refreshing run status every 10 seconds. Press Ctrl+C to quit."; sleep 30; fi
    watch "$3" "$@" ;;
  "run view "*) flag run_view_fails && fail "error connecting to api.github.com"; run_view "$3" | out ;;
  "api repos/fork/repo/check-runs/9001/annotations "*)
    if flag no_annotation; then
      echo '[{"annotation_level":"failure","message":"Process completed with exit code 1."}]'
    else
      jq -n --arg m "${S_ANNOTATION:-Your Anthropic account is out of credits. Add credits at https://console.anthropic.com/settings/billing, then run gh bouncer $PR_URL again.}" \
        '[{annotation_level: "failure", message: "Process completed with exit code 1."}, {annotation_level: "notice", message: "bouncer abc"}, {annotation_level: "failure", message: $m}]'
    fi | out ;;
  "pr comment 7 -R up/repo --body /bouncer check") flag comment_fails && fail "HTTP 403"; touch "$STUB/checked" ;;

  # --- init ---
  "api repos/me/proj --jq"*)
    push=true; flag no_write && push=false
    fork=false; flag is_fork && fork=true
    jq -n --arg db "$DB" --argjson push "$push" --argjson fork "$fork" \
      '{fork: $fork, default_branch: $db, permissions: {admin: $push, push: $push}, parent: (if $fork then {full_name: "up/proj"} else null end)}' | out ;;
  "api repos/gh-bouncer/action/contents/templates/bouncer.yml?ref=v1 "*) printf 'name: Bouncer\n' ;;
  "api repos/gh-bouncer/action/contents/templates/.bouncer.yml?ref=v1 "*) printf 'version: 1\n' ;;
  "api repos/me/proj/contents/.github/workflows/bouncer.yml?ref=$DB "*)
    flag installed_same && { printf 'name: Bouncer\n'; exit 0; }
    flag installed_old && { printf 'name: Bouncer (old)\n'; exit 0; }
    not_found ;;
  "api repos/me/proj/git/ref/heads/bouncer-setup --jq .ref")
    flag branch_exists || not_found; echo '{"ref":"refs/heads/bouncer-setup"}' | out ;;
  "pr list -R me/proj --head bouncer-setup "*)
    if flag setup_pr_open; then echo '[{"url":"https://github.com/me/proj/pull/1"}]'; else echo '[]'; fi | out ;;
  "api repos/me/proj/git/ref/heads/$DB --jq .object.sha") echo '{"object":{"sha":"abc123"}}' | out ;;
  "api -X POST repos/me/proj/git/refs -f ref=refs/heads/bouncer-setup -f sha=abc123")
    flag branch_exists && fail "gh: Reference already exists (HTTP 422)"; touch "$STUB/branch_created" ;;
  "api -X DELETE repos/me/proj/git/refs/heads/bouncer-setup") touch "$STUB/branch_deleted" ;;
  "api -X GET repos/me/proj/contents/.bouncer.yml -f ref=bouncer-setup --jq .sha")
    flag has_config || not_found; echo '{"sha":"cfgsha"}' | out ;;
  "api -X GET repos/me/proj/contents/.github/workflows/bouncer.yml -f ref=bouncer-setup --jq .sha")
    flag installed_old || not_found; echo '{"sha":"wfsha"}' | out ;;
  "api -X PUT repos/me/proj/contents/.github/workflows/bouncer.yml "*)
    flag no_workflow_scope && fail "gh: refusing to allow an OAuth App to create or update workflow \`.github/workflows/bouncer.yml\` without \`workflow\` scope (HTTP 404)"
    touch "$STUB/put_workflow" ;;
  "api -X PUT repos/me/proj/contents/.bouncer.yml "*) touch "$STUB/put_config" ;;
  "pr create -R me/proj "*) printf '%s\n' "$@" >"$STUB/pr_create"; echo "https://github.com/me/proj/pull/1" ;;

  *) echo "UNEXPECTED: $*" >>"$STUB/calls.log"; echo "stub gh: unexpected: $*" >&2; exit 99 ;;
esac
